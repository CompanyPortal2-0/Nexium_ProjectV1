# Supabase Configuration
# Choose ONE of the following configurations:

# OPTION 1: Local Supabase (Docker) - Use this if running Supabase locally
# Get these from your local Supabase instance
SUPABASE_URL=http://localhost:9999
SUPABASE_KEY=your-local-anon-key-here

# OPTION 2: Cloud Supabase - Use this if using Supabase cloud
# Get these values from your Supabase project dashboard
# https://app.supabase.com/project/YOUR_PROJECT/settings/api
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-anon-public-key-here

# Flask Configuration (change these in production!)
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
